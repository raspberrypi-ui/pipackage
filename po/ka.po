msgstr "სისტემაში დაყენებული პროგრამების დაყენება და წაშლა"

#: ../data/pi-packages.desktop.in.h:3
msgid "Updates;Upgrade;Sources;Repositories;Preferences;Install;Store;"
msgstr "Updates;Upgrade;Sources;Repositories;Preferences;Install;Store;განახლებები;წყარო;რეპოზიტორიები;დაყენება;"

